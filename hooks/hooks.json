{
  "description": "jev-flow: route directive, exploration and range-only hints, jev-locator model selection and hits, Jev payload guard and completion checks (gate runner receipts). Local work only; no tests or model calls, except the opt-in prompt-check (off by default), which for a prompt after the first makes two short Jev checks when the user switched it on with /jev:prompt-check.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/jev-flow-hook.mjs\" SessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/jev-flow-hook.mjs\" UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__(plugin_jev_)?jev__jev_.*|Bash|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/jev-flow-hook.mjs\" PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob|LS|Bash|Edit|Write|MultiEdit|NotebookEdit|Agent|Task|mcp__(plugin_jev_)?jev__jev_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/jev-flow-hook.mjs\" PostToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__(plugin_jev_)?jev__jev_.*|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/jev-flow-hook.mjs\" PostToolUseFailure",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/jev-flow-hook.mjs\" Stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "jev-locator|jev:jev-locator",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/jev-flow-hook.mjs\" SubagentStop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/jev-flow-hook.mjs\" SessionEnd",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
