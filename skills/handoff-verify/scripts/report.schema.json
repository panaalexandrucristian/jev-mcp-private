{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "handoff-verify report v1",
 "type": "object",
 "required": ["schema_version", "session", "variant", "environment", "handoff", "status", "checks", "findings", "unresolved", "kit", "cost", "patch"],
 "properties": {
  "schema_version": {"const": "1"},
  "session": {"type": "object", "required": ["session_id", "jsonl", "cwd"], "properties": {"session_id": {"type": "string"}, "jsonl": {"type": "string"}, "line": {"type": "string"}, "cwd": {"type": "string"}, "subagents": {"type": "array", "items": {"type": "string"}}, "continuations": {"type": "string"}}},
  "variant": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "commit": {"type": "string"}}},
  "environment": {"type": "object", "properties": {"model": {"type": "string"}, "claude_code": {"type": "string"}, "python": {"type": "string"}, "jq": {"type": "string"}, "git": {"type": "string"}, "kit": {"type": "string"}, "jev_model": {"type": "string"}}},
  "inventory": {"type": "array", "items": {"type": "object", "required": ["path", "disposition"], "properties": {"path": {"type": "string"}, "real": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}}, "copies": {"type": "array", "items": {"type": "string"}}, "disposition": {"type": "string"}, "classification": {"type": ["object", "null"]}, "linked": {"type": "boolean"}}}},
  "handoff": {"type": "object", "required": ["path", "versions"], "properties": {"path": {"type": "string"}, "source_path": {"type": "string"}, "versions": {"type": "array", "items": {"type": "object", "required": ["version", "sha256", "tool_use_id", "uuid", "timestamp", "evaluated_against"], "properties": {"version": {"type": "integer"}, "sha256": {"type": ["string", "null"]}, "tool_use_id": {"type": "string"}, "uuid": {"type": "string"}, "timestamp": {"type": "string"}, "evaluated_against": {"type": "string", "enum": ["prefix", "session_end"]}, "status": {"type": "string"}, "audited_status": {"type": "string", "enum": ["PASS", "FAIL", "UNRESOLVED"]}, "binding_summary": {"type": "object"}, "evaluations": {"type": "object"}, "attributed_write": {"type": "string"}, "attribution": {"type": "string"}}}}}},
  "source_ranges": {"type": "array", "items": {"type": "object", "required": ["id", "complete"], "properties": {"id": {"type": "string"}, "complete": {"type": "boolean"}, "chunks": {"type": "integer"}, "uuids": {"type": "array", "items": {"type": "string"}}}}},
  "status": {"type": "string", "enum": ["PASS", "FAIL", "UNRESOLVED"]},
  "status_claimed": {"type": ["string", "null"], "enum": ["PASS", "FAIL", "UNRESOLVED", null]},
  "jev_ref_version": {"const": "1"},
  "omission_contract": {"enum": ["R03", "R04"]},
 "work_locations": {"type": "array", "description": "The directories the user gave at prepare time (omissions.py/prepare.py --location): absolute, added after the note directory and the recorded write cwd to the bases of the omission material; one that no longer exists makes the material unavailable", "items": {"type": "string", "pattern": "^/"}},
  "binding_summary": {"type": "object", "properties": {"checks": {"type": "integer"}, "bound": {"type": "integer"}, "resolved": {"type": "integer"}, "unbound": {"type": "integer"}, "reasons": {"type": "array", "items": {"type": "string"}}, "calls_log_note": {"type": ["string", "null"]}, "jev_calls_in_log": {"type": "integer"}, "version_identity": {"type": "object"}}},
  "delivery": {"type": "object", "properties": {"delivery_state": {"enum": ["verified_version", "needs_reverification", "unresolved"]}, "current_sha256": {"type": ["string", "null"]}, "latest_write_id": {"type": ["string", "null"]}, "bound_checks_for_version": {"type": "integer"}, "reasons": {"type": "array", "items": {"type": "string"}}, "stale": {"type": "object", "required": ["report_version", "report_sha256", "newer_version", "newer_sha256"], "properties": {"report_version": {"type": "integer"}, "report_sha256": {"type": "string"}, "newer_version": {"type": "integer"}, "newer_sha256": {"type": "string"}}}}},
  "checks": {"type": "array", "items": {"type": "object", "required": ["id", "tool", "verdict", "confidence"], "properties": {"id": {"type": "string"}, "tool": {"type": "string"}, "verdict": {"type": ["string", "null"]}, "confidence": {"type": ["number", "null"]}, "input_hash": {"type": "string"}, "jev_ref": {"type": ["object", "null"], "required": ["tool_use_id", "result_index", "key"], "properties": {"tool_use_id": {"type": "string"}, "result_index": {"type": "integer", "minimum": 0}, "key": {"type": "string"}}}, "binding": {"type": "object", "properties": {"bound": {"type": "boolean"}, "reason": {"type": ["string", "null"]}, "resolved": {"type": "boolean"}, "aux_ok": {"type": "boolean"}}}, "version_ref": {"type": ["object", "null"], "required": ["write_tool_use_id", "sha256", "evaluated_against"], "properties": {"write_tool_use_id": {"type": "string"}, "sha256": {"type": "string"}, "evaluated_against": {"type": "string", "enum": ["prefix", "session_end"]}}}, "retries": {"type": "integer"}, "error": {"type": ["string", "null"]}, "resolved": {"type": "boolean"}, "advice": {"type": "object", "description": "Written by report.py (advice.py) on a bound, unresolved verify/gate check: what to try in the single re-verification (codes: evidence_off_subject, fix_fact, recheck_fact, remove_unsupported_detail, add_source_passage, add_direct_evidence, aux_condition_failed, result_mismatch, no_result); informative, never changes the status", "required": ["code", "hint"], "properties": {"code": {"type": "string"}, "hint": {"type": "string"}, "details": {"type": "array", "items": {"type": "string"}}, "split": {"type": "boolean"}}}}}},
  "findings": {"type": "array", "items": {"type": "object", "required": ["type", "category", "quote_handoff", "quote_source", "uuid", "check_id", "confidence"], "properties": {"type": {"enum": ["lost_detail", "wrong_fact", "dead_path", "stale_state"]}, "category": {"type": "string"}, "quote_handoff": {"type": ["string", "null"]}, "quote_source": {"type": ["string", "null"]}, "uuid": {"type": ["string", "null"]}, "check_id": {"type": "string"}, "confidence": {"type": ["number", "null"]}, "claim": {"type": ["string", "null"]}, "omission_ref": {"type": ["object", "null"], "properties": {"detail": {"type": "string"}, "source_check_id": {"type": "string"}}}}}},
  "unresolved": {"type": "array", "items": {"type": "object", "required": ["check_id", "reason"], "properties": {"check_id": {"type": "string"}, "reason": {"type": "string"}}}},
  "scope_exclusions": {"type": "array", "description": "R05: candidate details excluded as outside the session scope (the user's requests): only a real jev_classify result out_of_scope with confidence strictly > 0.99 and decision auto (scope.py)", "items": {"type": "object", "required": ["detail", "jev_ref", "classification", "confidence"], "properties": {"detail": {"type": "string"}, "jev_ref": {"type": "object", "required": ["tool_use_id", "result_index", "key"], "properties": {"tool_use_id": {"type": "string"}, "result_index": {"type": "integer"}, "key": {"type": "string"}}}, "classification": {"type": "string"}, "confidence": {"type": "number"}}}},
  "scope_audit": {"type": "object", "description": "Written by report.py: the re-derived scope exclusions; an invalid one makes a PASS UNRESOLVED", "properties": {"threshold": {"type": "number"}, "valid": {"type": "integer"}, "invalid": {"type": "integer"}, "reasons": {"type": "array"}}},
  "kit": {"type": "object", "properties": {"status": {"type": "string"}, "exit": {"type": ["integer", "null"]}, "section4": {"type": "string"}, "skips": {"type": "array", "items": {"type": "string"}}}},
  "cost": {"type": "object", "properties": {"tokens": {"type": ["number", "string"]}, "usd": {"type": ["number", "string"]}, "wall_s": {"type": ["number", "string"]}, "jev_calls": {"type": "integer"}}},
  "patch": {"type": "object", "required": ["proposed", "approved"], "properties": {"proposed": {"type": "boolean"}, "gate_confidence": {"type": ["number", "null"]}, "approved": {"type": "boolean"}, "applied": {"type": "boolean"}, "backup": {"type": ["string", "null"]}}}
 }
}
